{
  "name": "identity-inspector",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc -b && pnpm --filter @identity-inspector/web build",
    "typecheck": "tsc -b && tsc -p packages/web",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "tsc -b && pnpm --filter @identity-inspector/web dev",
    "e2e": "playwright test",
    "e2e:up": "docker compose up -d --wait",
    "e2e:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
